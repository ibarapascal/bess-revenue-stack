__pycache__/
*.pyc
.DS_Store
.venv/
# Cached market data only. Anchored with a leading slash: a bare `data/` matches
# at any depth and silently swallows src/bess/data/, which every script imports —
# invisible locally because the files are already on disk.
/data/
/results/*.parquet

# Internal working context: machine names, local paths, strategy notes.
# Not for publication.
CLAUDE.md
.worklog.md
.learning-draft-*.md
.review-final.md

# deck: the distributed PDF is tracked — it is served from the company site, so the
# exact published bytes have to be traceable to a commit (re-rendering does not
# reproduce them byte for byte). Everything else under out/ is proofing output.
deck/out/*
!deck/out/*.pdf
deck/__pycache__/
